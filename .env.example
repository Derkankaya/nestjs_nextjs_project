# Global Docker Compose variables (copy to `.env` in the project root).
# Do not put JWT secrets or API keys here.

POSTGRES_USER=blog
POSTGRES_PASSWORD=1234
POSTGRES_DB=blog_template
POSTGRES_PORT=5432

BACKEND_PORT=3001
FRONTEND_PORT=3000
# JWT Gizli Anahtarı (Backend için)
JWT_SECRET=super_secret_jwt_key_123

# Veritabanı Bağlantı URL'si (Backend ve Prisma için)
DATABASE_URL="postgresql://blog:1234@postgres:5432/blog_template?schema=public"