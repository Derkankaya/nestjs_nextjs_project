# Backend secrets only (copy to `backend/.env`).
# Used by NestJS / Prisma. Never expose these to the frontend.

# Local development (host machine → published Postgres port).
# Inside Docker Compose, DATABASE_URL is overridden to use the `postgres` service hostname.
DATABASE_URL=postgresql://blog:1234@localhost:5432/blog_template?schema=public

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development
